server {
    listen 80;
    listen [::]:80;

    listen 7812;
    listen [::]:7812;


    root /home/dev/Automated-Reputation-Management-System/frontend;
    index index.html index.htm;

    server_name _;

    location / {
        # Attempts to serve the file, falls back to a 404 error
        try_files $uri $uri/ =404;
    }
}