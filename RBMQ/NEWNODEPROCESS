RUN THIS BLOCK TO JOIN CLUSTER

------------------------------------------------------------------------
sudo systemctl stop rabbitmq-server
sudo rm -rf /var/lib/rabbitmq/mnesia

echo "P3TLc96XfCPueRVe4TCHVscCX+3VLm6CRssjxpnZ+5J9W6Pl3xDe9K+x" | sudo tee /var/lib/rabbitmq/.erlang.cookie
sudo chown rabbitmq:rabbitmq /var/lib/rabbitmq/.erlang.cookie
sudo chmod 400 /var/lib/rabbitmq/.erlang.cookie

sudo mkdir -p /etc/rabbitmq
cat << 'EOF' | sudo tee /etc/rabbitmq/rabbitmq.conf
cluster_partition_handling = autoheal
EOF

cat << 'EOF' | sudo tee /etc/rabbitmq/advanced.config
[
  {os_mon, [
    {start_cpu_sup, false},
    {start_disksup, false},
    {start_memsup, false}
  ]}
].
EOF

sudo systemctl start rabbitmq-server
sudo rabbitmq-plugins enable rabbitmq_management
